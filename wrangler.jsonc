// Cloudflare deployment (Workers with static assets).
//   Git integration: Workers & Pages → Create → Import a repository →
//     build command `npm run build`, deploy command `npx wrangler deploy`.
//   Manual: `npm run build && npx wrangler deploy`
// The site is fully static: no Worker script runs, assets are served from the
// edge. public/_headers (security and cache headers) is applied automatically.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "swiss-alternatives",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
  },
  "observability": { "enabled": false },
}
