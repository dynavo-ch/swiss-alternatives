{
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    { "files": "*.astro", "options": { "parser": "astro" } },
    {
      "files": ["*.md", "*.yaml", "*.yml"],
      "options": { "printWidth": 100, "proseWrap": "preserve" }
    }
  ]
}
