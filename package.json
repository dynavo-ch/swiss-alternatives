{
  "name": "swiss-alternatives",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A static directory of Swiss alternatives to international software and cloud services.",
  "license": "MIT",
  "homepage": "https://swiss-alternatives.ch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynavo-ch/swiss-alternatives.git"
  },
  "keywords": [
    "switzerland",
    "directory",
    "software",
    "alternatives",
    "digital-sovereignty",
    "astro"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm run lint && npm run lint:content && npm run build && npm run check:links",
    "astro": "astro",
    "lint:content": "node scripts/lint-content.mjs",
    "sync:repos": "node scripts/sync-repos.mjs",
    "schemas": "astro sync && node scripts/export-schemas.mjs",
    "new": "node scripts/new-entry.mjs",
    "logos": "node scripts/fetch-logos.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.0",
    "lucide-static": "^1.57.0",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "yaml": "^2.9.1"
  }
}
