---
/**
 * Listing criteria and verification methodology. Tables are rendered from
 * the same rule definitions the build uses (src/lib/signals.ts), so the
 * published rules cannot drift from the implementation.
 */
import Badge from '~/components/Badge.astro';
import PageHeader from '~/components/PageHeader.astro';
import { useTranslations } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getDirectory } from '~/lib/data';
import { paths } from '~/lib/paths';
import { breadcrumbLd } from '~/lib/seo';
import { CLASSIFICATIONS, FOOTPRINT_DIMENSIONS, SIGNAL_KEYS } from '~/lib/signals';

const t = useTranslations(Astro.currentLocale);
const { products } = await getDirectory();
const tierCount = (c: string) => products.filter((p) => p.classification === c).length;

const crumbs = [
  { label: t('nav.home'), href: paths.home() },
  { label: t('nav.methodology'), href: paths.methodology() },
];

const tierRules: Record<string, string> = {
  'swiss-native':
    'Swiss headquarters and incorporation · Swiss ultimate owner (yes) · developed in Switzerland (yes or partly)',
  'swiss-company':
    'Swiss headquarters and incorporation · ownership mixed or unverified, or development mainly abroad',
  'swiss-company-foreign-parent':
    'Swiss headquarters and incorporation · ultimate owner outside Switzerland',
  'swiss-open-source':
    'No Swiss operating company · open-source licence · primarily developed in Switzerland',
  'swiss-hosted-foreign': 'Foreign company · core customer data hosted in Switzerland by default',
};

const signalRules: Record<string, string> = {
  'swiss-company': 'Company headquarters = CH and legal jurisdiction = CH',
  'swiss-owned': 'Company ownership.swissOwned = yes',
  'swiss-developed': 'Product swiss.developed = yes',
  'swiss-hosted': 'Product swiss.hosted = yes',
  'swiss-residency': 'Product swiss.hosted = optional or partial',
  'swiss-infrastructure': 'swiss.hosted = yes and infrastructure operator Swiss-owned = yes',
  'open-source': 'openSource = yes (client and server)',
  'self-hostable': 'Deployment includes self-hosted or on-premises',
  'free-plan': 'pricing.freePlan = yes',
};
---

<BaseLayout
  title={t('methodology.title')}
  description={t('methodology.description')}
  jsonLd={breadcrumbLd(crumbs)}
>
  <PageHeader
    crumbs={crumbs}
    eyebrow={t('nav.methodology')}
    title={t('methodology.heading')}
    lead={t('methodology.description')}
  />

  <div class="container section meth">
    <nav class="meth__toc" aria-label={t('nav.onThisPage')}>
      <ol role="list">
        <li>
          <a href="#summary">Summary</a>
        </li>
        <li>
          <a href="#criteria">Who qualifies</a>
        </li>
        <li>
          <a href="#tiers">Classification</a>
        </li>
        <li>
          <a href="#footprint">Swiss footprint</a>
        </li>
        <li>
          <a href="#badges">Badges</a>
        </li>
        <li>
          <a href="#verification">Verification</a>
        </li>
        <li>
          <a href="#ordering">Ordering & independence</a>
        </li>
        <li>
          <a href="#limits">Limitations</a>
        </li>
        <li>
          <a href="#corrections">Corrections</a>
        </li>
      </ol>
    </nav>

    <div class="prose meth__body">
      <h2 id="summary">Summary</h2>
      <p>
        We list software and digital services from organisations{' '}
        <strong>headquartered and legally incorporated in Switzerland</strong>. Being a Swiss
        company is the entry ticket — it says nothing yet about where data is stored. That is why
        every entry answers five questions separately: headquarters, ownership, development, hosting
        and infrastructure.
      </p>
      <p>
        A Swiss SaaS company running on a hyperscaler in Frankfurt is listed as a Swiss company, but
        does <em>not</em> get a “Hosted in Switzerland” badge. A foreign company that merely
        operates a data centre in Zurich is <em>not</em> a Swiss software provider.
      </p>

      <h2 id="criteria">Who qualifies</h2>
      <p>
        A product is listed when <strong>one</strong> of the following is true:
      </p>
      <ol>
        <li>
          <strong>Swiss operating company.</strong> The organisation that develops and operates the
          product is headquartered in Switzerland and registered in the Swiss commercial register
          (or is a Swiss foundation, association, cooperative or public institution).
        </li>
        <li>
          <strong>Swiss-developed open source.</strong> The product is open source and primarily
          developed in Switzerland, even without a Swiss operating company.
        </li>
        <li>
          <strong>Swiss-hosted foreign service.</strong> A foreign company hosts core customer data
          in Switzerland by default. Such entries are clearly labelled and never described as Swiss
          companies.
        </li>
      </ol>
      <p>
        In addition, the product must be actively offered and available to customers in Switzerland.
      </p>
      <h3>Parent companies and subsidiaries</h3>
      <ul>
        <li>
          A Swiss company that is <strong>acquired by a foreign group</strong> stays listed as long
          as it remains headquartered in Switzerland and operates the product from there. It is
          classified as <em>Swiss company · foreign parent</em> and does not receive the “Swiss
          Owned” badge.
        </li>
        <li>
          A <strong>Swiss subsidiary of a foreign corporation</strong> that sells its parent’s
          products (for example a local sales office) does not qualify — the product is not
          developed or operated by a Swiss organisation.
        </li>
        <li>
          <strong>Resellers</strong> of foreign software do not qualify. Swiss providers that build
          their own service on foreign cloud infrastructure do qualify — the infrastructure is shown
          openly.
        </li>
      </ul>
      <p>
        These rules are enforced by the build: an entry that fits none of the tiers fails validation
        and is not published.
      </p>

      <h2 id="tiers">Classification</h2>
      <p>
        Every listed product receives exactly one classification, derived automatically from its
        data.
      </p>
    </div>

    <div class="meth__wide">
      <div class="table-wrap">
        <table class="rules">
          <thead>
            <tr>
              <th scope="col">Classification</th>
              <th scope="col">Meaning</th>
              <th scope="col">Rule</th>
              <th scope="col" class="num">
                Listed
              </th>
            </tr>
          </thead>
          <tbody>
            {CLASSIFICATIONS.map((c) => (
              <tr>
                <th scope="row">{t(`class.${c}`)}</th>
                <td>{t(`class.${c}.desc`)}</td>
                <td class="rules__rule">{tierRules[c]}</td>
                <td class="num tnum">{tierCount(c)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="prose meth__body">
      <h2 id="footprint">Swiss footprint</h2>
      <p>
        The footprint is shown as five squares on every card. Each square is one independent
        question, answered with <em>yes</em>, <em>partly</em>, <em>no</em> or <em>unknown</em>:
      </p>
      <ol>
        {FOOTPRINT_DIMENSIONS.map((d) => (
          <li>
            <strong>{t(`footprint.${d}`)}</strong> — {t(`footprint.${d}.q`)}
          </li>
        ))}
      </ol>
      <p>
        <em>Partly</em> is used for hosting when only part of the data, or only some customers, are
        served from Switzerland, or when Swiss hosting is an option rather than the default.
        Infrastructure counts the operator of the servers — the company itself, a Swiss provider, or
        a foreign cloud — not the building it sits in.
      </p>
      <p>
        The optional sort order <strong>“Swiss footprint”</strong> adds one point per <em>yes</em>{' '}
        and half a point per <em>partly</em>. It is a transparent count, not a quality rating.
      </p>

      <h2 id="badges">Badges</h2>
      <p>
        Badges are computed from the data. Cards show at most three; the product page shows all that
        apply.
      </p>
    </div>

    <div class="meth__wide">
      <div class="table-wrap">
        <table class="rules">
          <thead>
            <tr>
              <th scope="col">Badge</th>
              <th scope="col">Meaning</th>
              <th scope="col">Rule</th>
            </tr>
          </thead>
          <tbody>
            {SIGNAL_KEYS.map((key) => (
              <tr>
                <th scope="row">
                  <Badge signal={key} />
                </th>
                <td>{t(`signal.${key}.desc`)}</td>
                <td class="rules__rule mono">{signalRules[key]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="prose meth__body">
      <h2 id="verification">Verification</h2>
      <p>
        Every statement about ownership, development, hosting and infrastructure carries a basis:
      </p>
      <ul>
        <li>
          <strong>{t('basis.verified')}</strong> — {t('basis.verified.desc')}
        </li>
        <li>
          <strong>{t('basis.vendor')}</strong> — {t('basis.vendor.desc')}
        </li>
        <li>
          <strong>{t('basis.inferred')}</strong> — {t('basis.inferred.desc')}
        </li>
      </ul>
      <p>
        Typical sources are the Swiss commercial register (Zefix) and UID register, vendors’ legal
        notices, privacy policies, sub-processor lists, data-centre documentation and press releases
        about acquisitions. Each entry links its sources and shows the date it was last verified. We
        aim to re-verify every entry at least once a year and whenever a significant change (such as
        an acquisition) becomes known.
      </p>
      <p>
        Missing information is shown as <strong>Unknown / not verified</strong>. It is never
        converted into “No” — especially not for statements about data location or ownership.
      </p>

      <h2 id="ordering">Ordering & independence</h2>
      <ul>
        <li>
          Lists are sorted alphabetically by default. Other sort orders are labelled and explained.
        </li>
        <li>There is no editorial score, no “best” label and no paid placement.</li>
        <li>
          If affiliate links or sponsorships are ever introduced, they will be marked on the entry
          and will not influence inclusion, classification or ordering.
        </li>
        <li>
          “Alternative to” means overlapping functionality, not a one-to-one replacement.
          Differences are noted where known.
        </li>
      </ul>

      <h2 id="limits">Limitations</h2>
      <ul>
        <li>
          Swiss jurisdiction is not a privacy guarantee. Swiss providers are subject to Swiss law,
          including the surveillance act (BÜPF/LSCPT) and court orders, and may be subject to
          foreign law where they operate abroad.
        </li>
        <li>
          Hosting arrangements change. Always confirm current details in the vendor’s contract or
          data processing agreement.
        </li>
        <li>
          The directory is not exhaustive. Absence from the list says nothing about a product’s
          quality.
        </li>
      </ul>

      <h2 id="corrections">Corrections</h2>
      <p>
        Every product page has a <em>Report an error</em> link. Vendors are welcome to submit
        corrections with sources; we update entries when the evidence supports it. See{' '}
        <a href={paths.suggest()}>Suggest a product</a> for how to propose new entries.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .meth {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 0 var(--s-12);
  }

  .meth__toc {
    grid-row: 1 / span 10;
  }

  .meth__toc ol {
    position: sticky;
    top: calc(var(--header-h) + var(--s-6));
    font-size: var(--fs-sm);
  }

  .meth__toc li + li {
    margin-top: var(--s-2);
  }

  .meth__toc a {
    color: var(--c-ink-3);
    text-decoration: none;
  }

  .meth__toc a:hover {
    color: var(--c-ink);
  }

  .meth__body,
  .meth__wide {
    grid-column: 2;
  }

  .meth__body :global(h2) {
    scroll-margin-top: calc(var(--header-h) + var(--s-6));
  }

  .meth__body > :global(h2:first-child) {
    margin-top: 0;
  }

  .meth__wide {
    margin-block: var(--s-6) var(--s-4);
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--c-line);
    border-radius: var(--r-2);
    background: var(--c-surface);
  }

  .rules {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }

  .rules th,
  .rules td {
    padding: var(--s-3) var(--s-4);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--c-line);
  }

  .rules tbody tr:last-child > * {
    border-bottom: 0;
  }

  .rules thead th {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-ink-3);
    background: var(--c-sunken);
  }

  .rules tbody th {
    font-weight: 600;
    white-space: nowrap;
  }

  .rules__rule {
    color: var(--c-ink-3);
    font-size: var(--fs-xs);
  }

  .rules .num {
    text-align: right;
  }

  @media (max-width: 60rem) {
    .meth {
      grid-template-columns: 1fr;
    }
    .meth__toc {
      display: none;
    }
    .meth__body,
    .meth__wide {
      grid-column: 1;
    }
  }
</style>
