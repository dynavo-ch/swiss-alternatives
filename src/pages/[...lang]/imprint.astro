---
import Email from '~/components/Email.astro';
import ProsePage from '~/components/ProsePage.astro';
import { site } from '~/config/site';
import { useTranslations } from '~/i18n';
import { localeStaticPaths } from '~/i18n/routing';
import { countryName } from '~/lib/format';

export const getStaticPaths = localeStaticPaths;
const locale = Astro.currentLocale;
const t = useTranslations(locale);
const o = site.operator;
---

<ProsePage slug="imprint">
  <Fragment slot="before">
    <h2>{t('imprint.operator')}</h2>
    <p>
      {o.name}
      <br />
      {o.street && (
        <>
          {o.street}
          <br />
        </>
      )}
      {o.postalCode} {o.city}
      <br />
      {countryName(o.country, locale)}
    </p>
    <p>
      {t('imprint.email')}: <Email address={o.email} />
    </p>
  </Fragment>
</ProsePage>
