---
/**
 * Contribution hub: every way to help, from a one-line suggestion to a pull
 * request, plus how to reuse the open data.
 */
import Icon from '~/components/Icon.astro';
import PageHeader from '~/components/PageHeader.astro';
import { site } from '~/config/site';
import { useTranslations } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getDirectory } from '~/lib/data';
import { paths } from '~/lib/paths';
import { breadcrumbLd } from '~/lib/seo';
import { localeStaticPaths } from '~/i18n/routing';

export const getStaticPaths = localeStaticPaths;

const t = useTranslations(Astro.currentLocale);
const { stats } = await getDirectory(Astro.currentLocale);
const repo = site.repository;
const branch = site.repositoryBranch;
const crumbs = [
  { label: t('nav.home'), href: paths.home() },
  { label: t('nav.contribute'), href: paths.contribute() },
];

const ways = [
  { id: 'suggest', icon: 'plus', href: paths.suggest() },
  { id: 'correct', icon: 'flag', href: `${repo}/issues/new?template=correction.yml` },
  { id: 'entries', icon: 'git-pull-request', href: `${repo}/blob/${branch}/docs/CONTENT.md` },
  { id: 'logos', icon: 'image', href: `${repo}/blob/${branch}/src/assets/logos/README.md` },
  {
    id: 'translate',
    icon: 'languages',
    href: `${repo}/blob/${branch}/README.md#internationalisation`,
  },
  { id: 'code', icon: 'code', href: `${repo}/blob/${branch}/CONTRIBUTING.md` },
] as const;
---

<BaseLayout
  title={t('contribute.title')}
  description={t('contribute.description')}
  jsonLd={breadcrumbLd(crumbs)}
>
  <PageHeader
    crumbs={crumbs}
    eyebrow={t('nav.contribute')}
    title={t('contribute.heading')}
    lead={t('contribute.lead', { count: stats.products })}
  >
    <p class="cta-row">
      <a href={repo} class="btn btn--primary" rel="noopener">
        <Icon name="github" />
        {t('contribute.repo')}
      </a>
      <a href={paths.suggest()} class="btn">
        <Icon name="plus" />
        {t('nav.suggest')}
      </a>
    </p>
  </PageHeader>

  <section class="section container" aria-labelledby="ways-h">
    <h2 class="label" id="ways-h">
      {t('contribute.ways')}
    </h2>
    <ol class="ways" role="list">
      {ways.map((way, i) => (
        <li class="way">
          <span class="way__num mono">{String(i + 1).padStart(2, '0')}</span>
          <Icon name={way.icon} class="way__icon" />
          <h3>{t(`contribute.way.${way.id}.title`)}</h3>
          <p>{t(`contribute.way.${way.id}.text`)}</p>
          <a
            href={way.href}
            class="arrow-link"
            rel={way.href.startsWith('http') ? 'noopener' : undefined}
          >
            {t(`contribute.way.${way.id}.label`)}
            <Icon name="arrow-right" />
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="section container" aria-labelledby="flow-h">
    <div class="split">
      <div>
        <h2 class="h2" id="flow-h">
          {t('contribute.flowTitle')}
        </h2>
        <p class="lead">{t('contribute.flowLead')}</p>
      </div>
      <ol class="flow" role="list">
        {([1, 2, 3, 4] as const).map((step) => (
          <li set:html={t(`contribute.flow.${step}`)} />
        ))}
      </ol>
    </div>
  </section>

  <section class="section container" aria-labelledby="data-h">
    <div class="split">
      <div>
        <h2 class="h2" id="data-h">
          {t('contribute.dataTitle')}
        </h2>
        <p class="lead">{t('contribute.dataLead')}</p>
      </div>
      <dl class="endpoints">
        <div>
          <dt>
            <a href={paths.productData()} class="mono">
              /data/products.json
            </a>
          </dt>
          <dd>{t('contribute.endpoint.products')}</dd>
        </div>
        <div>
          <dt>
            <a href="/data/directory.json" class="mono">
              /data/directory.json
            </a>
          </dt>
          <dd>{t('contribute.endpoint.directory')}</dd>
        </div>
        <div>
          <dt>
            <a href={paths.searchIndex()} class="mono">
              /search-index.json
            </a>
          </dt>
          <dd>{t('contribute.endpoint.search')}</dd>
        </div>
        <div>
          <dt>
            <a href={paths.rss()} class="mono">
              /latest/rss.xml
            </a>
          </dt>
          <dd>{t('contribute.endpoint.rss')}</dd>
        </div>
        <div>
          <dt>
            <span class="mono">{t('contribute.license')}</span>
          </dt>
          <dd>{t('contribute.licenseText')}</dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-6);
  }

  .ways {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin-top: var(--s-4);
  }

  .way {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--s-3);
    padding: var(--s-6);
    border: 1px solid var(--c-line);
    border-top: 2px solid var(--c-ink);
    background: var(--c-surface);
  }

  .way__num {
    font-size: var(--fs-xs);
    color: var(--c-red-ink);
  }

  .way :global(.way__icon) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .way h3 {
    font-size: var(--fs-md);
  }

  .way p {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: var(--s-12);
    padding-top: var(--s-8);
    border-top: 1px solid var(--c-ink);
  }

  .split .lead {
    margin-top: var(--s-4);
  }

  .flow {
    display: grid;
    gap: var(--s-4);
    counter-reset: step;
  }

  .flow li {
    counter-increment: step;
    position: relative;
    padding-left: 2.5rem;
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--c-line);
    color: var(--c-ink-2);
  }

  .flow li::before {
    position: absolute;
    left: 0;
    top: 0;
    content: counter(step, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-red-ink);
    padding-top: 0.2rem;
  }

  .flow strong {
    color: var(--c-ink);
  }

  .flow code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.05em 0.3em;
    background: var(--c-sunken);
    border-radius: var(--r-1);
  }

  .endpoints > div {
    display: grid;
    grid-template-columns: minmax(0, 14rem) 1fr;
    gap: var(--s-4);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--c-line);
    font-size: var(--fs-sm);
  }

  .endpoints dd {
    color: var(--c-ink-2);
  }

  @media (max-width: 60rem) {
    .ways {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .split {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }
  }

  @media (max-width: 36rem) {
    .ways {
      grid-template-columns: 1fr;
    }
    .endpoints > div {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }
  }
</style>
