---
import AlternativeCard from '~/components/AlternativeCard.astro';
import EmptyState from '~/components/EmptyState.astro';
import Footprint from '~/components/Footprint.astro';
import Icon from '~/components/Icon.astro';
import PageHeader from '~/components/PageHeader.astro';
import ProductCard from '~/components/ProductCard.astro';
import SectionHeader from '~/components/SectionHeader.astro';
import { site } from '~/config/site';
import { useTranslations } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getDirectory, relatedAlternatives, type Alternative } from '~/lib/data';
import { countryName, displayHost, formatPrice, list } from '~/lib/format';
import { paths } from '~/lib/paths';
import { alternativeLd, breadcrumbLd } from '~/lib/seo';
import { localeRoutes } from '~/i18n/routing';

export function getStaticPaths() {
  return localeRoutes(async (locale) => {
    const { alternatives } = await getDirectory(locale);
    return alternatives.map((alternative) => ({
      params: { slug: alternative.id },
      props: { alternative },
    }));
  });
}

interface Props {
  alternative: Alternative;
}

const { alternative } = Astro.props;
const locale = Astro.currentLocale;
const t = useTranslations(locale);
const a = alternative.data;
const links = [...alternative.products].sort(
  (x, y) =>
    y.product.footprintScore - x.product.footprintScore ||
    x.product.name.localeCompare(y.product.name),
);
const count = links.length;
const related = relatedAlternatives(alternative, 6);
const primary = alternative.categories[0];
const noun = primary?.noun ?? 'services';

const crumbs = [
  { label: t('nav.home'), href: paths.home() },
  { label: t('nav.alternatives'), href: paths.alternatives() },
  { label: alternative.name, href: alternative.url },
];

const compareIds = links.slice(0, site.compareLimit).map((l) => l.product.id);
const title = t('alt.metaTitle', { name: alternative.name });
const description =
  count > 0
    ? t('alt.metaDescription', {
        count,
        name: alternative.name,
        products: list(
          links.slice(0, 4).map((l) => l.product.name),
          locale,
        ),
      })
    : t('alt.metaDescriptionEmpty', { name: alternative.name });

const state = (value: string | undefined) => value ?? 'unknown';
const stateLabel = (value: string | undefined) =>
  !value || value === 'unknown' ? t('state.unknownShort') : t(`state.${value as 'yes'}`);
---

<BaseLayout
  title={title}
  description={description}
  noindex={count === 0}
  jsonLd={
    count > 0 ? [alternativeLd(alternative, title), breadcrumbLd(crumbs)] : breadcrumbLd(crumbs)
  }
>
  <PageHeader
    crumbs={crumbs}
    eyebrow={`${t('search.type.alternative')} · ${a.vendor} · ${countryName(a.vendorCountry, locale)}`}
    title={title}
    lead={
      count > 0
        ? t('alt.lead', { noun, name: alternative.name, count })
        : t('alt.leadEmpty', { name: alternative.name })
    }
  >
    <div class="original">
      <div class="original__body">
        <p class="label">{t('alt.replacing')}</p>
        <p class="original__name">
          {alternative.name}
          {a.status === 'discontinued' && <span class="badge">{t('common.discontinued')}</span>}
        </p>
        <p class="original__summary">{a.summary}</p>
      </div>
      <dl class="original__facts">
        <div>
          <dt>{t('alt.vendor')}</dt>
          <dd>{a.vendor}</dd>
        </div>
        {a.parent && (
          <div>
            <dt>{t('company.parent')}</dt>
            <dd>{a.parent}</dd>
          </div>
        )}
        <div>
          <dt>{t('alt.vendorCountry')}</dt>
          <dd>
            {countryName(a.vendorCountry, locale)} <span class="mono muted">{a.vendorCountry}</span>
          </dd>
        </div>
        <div>
          <dt>{t('product.categories')}</dt>
          <dd>
            {alternative.categories.map((c, i) => (
              <>
                {i > 0 && ', '}
                <a href={c.url}>{c.name}</a>
              </>
            ))}
          </dd>
        </div>
        <div>
          <dt>{t('common.website')}</dt>
          <dd>
            <a href={a.website} rel="noopener nofollow" class="mono">
              {displayHost(a.website)}
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </PageHeader>

  {count > 0 ? (
    <>
      <section class="section container" aria-labelledby="list-h">
        <SectionHeader
          id="list-h"
          number={1}
          title={t('count.swissAlternatives', { count })}
          lead={t('alt.listLead')}
        />
        <ul class="grid-cards" role="list">
          {links.map(({ product }) => (
            <li>
              <ProductCard product={product} />
            </li>
          ))}
        </ul>
      </section>

      <section class="section container" aria-labelledby="glance-h">
        <SectionHeader
          id="glance-h"
          number={2}
          title={t('alt.glance')}
          lead={t('alt.glanceLead', { name: alternative.name })}
        />
        <div class="glance-wrap">
          <table class="glance">
            <caption class="visually-hidden">{t('alt.glance')}</caption>
            <thead>
              <tr>
                <th scope="col">{t('alt.colProduct')}</th>
                <th scope="col">{t('footprint.title')}</th>
                <th scope="col">{t('footprint.hosting')}</th>
                <th scope="col">{t('product.openSource')}</th>
                <th scope="col">{t('pricing.freePlan')}</th>
                <th scope="col">{t('pricing.startingAt')}</th>
                <th scope="col">{t('alt.colDiffers', { name: alternative.name })}</th>
              </tr>
            </thead>
            <tbody>
              {links.map(({ product, note }) => {
                const d = product.data;
                const price = d.pricing?.startingPrice;
                return (
                  <tr>
                    <th scope="row">
                      <a href={product.url}>{product.name}</a>
                      <span class="glance__company">
                        {product.company.displayName}
                        {product.company.data.headquarters.canton
                          ? ` · ${product.company.data.headquarters.canton}`
                          : ''}
                      </span>
                    </th>
                    <td>
                      <span class="glance__fp">
                        <Footprint footprint={product.footprint} />
                        <span>{t(`class.${product.classification}`)}</span>
                      </span>
                    </td>
                    <td>
                      <span class="state" data-state={state(d.swiss.hosted?.value)}>
                        {stateLabel(d.swiss.hosted?.value)}
                      </span>
                      {d.swiss.dataLocations.length > 0 && (
                        <span class="glance__sub mono">{d.swiss.dataLocations.join(' · ')}</span>
                      )}
                    </td>
                    <td>
                      <span class="state" data-state={state(d.openSource?.value)}>
                        {stateLabel(d.openSource?.value)}
                      </span>
                    </td>
                    <td>
                      <span class="state" data-state={state(d.pricing?.freePlan)}>
                        {stateLabel(d.pricing?.freePlan)}
                      </span>
                    </td>
                    <td class="tnum">
                      {price ? (
                        formatPrice(price, (period) => t(`pricing.period.${period}`), locale)
                      ) : (
                        <span class="muted">—</span>
                      )}
                    </td>
                    <td class="glance__note">
                      {note ?? <span class="muted">{t('alt.noNote')}</span>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        {compareIds.length > 1 && (
          <p class="glance__cta">
            <a href={`${paths.compare()}?products=${compareIds.join(',')}`} class="btn">
              <Icon name="columns-3" />
              {t('alt.compareAll', { count: compareIds.length })}
            </a>
          </p>
        )}
      </section>
    </>
  ) : (
    <section class="section container">
      <EmptyState title={t('alt.emptyTitle', { name: alternative.name })} text={t('alt.emptyText')}>
        <div class="empty-actions">
          <a href={paths.suggest()} class="btn btn--primary">
            <Icon name="plus" />
            {t('nav.suggest')}
          </a>
          {primary && (
            <a href={primary.url} class="btn">
              {t('alt.browseCategory', { category: primary.name })}
            </a>
          )}
        </div>
      </EmptyState>
    </section>
  )}

  {related.length > 0 && (
    <section class="section container" aria-labelledby="rel-h">
      <SectionHeader
        id="rel-h"
        title={t('alt.related')}
        href={paths.alternatives()}
        linkLabel={t('common.viewAll')}
      />
      <ul class="grid-cards grid-cards--sm" role="list">
        {related.map((alt) => (
          <li>
            <AlternativeCard alternative={alt} />
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .original {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-6);
    margin-top: var(--s-8);
    padding: var(--s-5) var(--s-6);
    border: 1px solid var(--c-line);
    border-radius: var(--r-2);
    background: var(--c-surface);
  }

  .original__name {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-2);
    font-size: var(--fs-lg);
    font-weight: 640;
    letter-spacing: -0.02em;
  }

  .original__summary {
    margin-top: var(--s-2);
    color: var(--c-ink-2);
  }

  .original__facts {
    display: grid;
    gap: var(--s-2);
    font-size: var(--fs-sm);
  }

  .original__facts div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--s-3);
  }

  .original__facts dt {
    color: var(--c-ink-3);
  }

  @media (max-width: 48rem) {
    .original {
      grid-template-columns: 1fr;
    }
  }

  .glance-wrap {
    overflow-x: auto;
    border: 1px solid var(--c-line);
    border-radius: var(--r-2);
    background: var(--c-surface);
  }

  .glance {
    width: 100%;
    min-width: 56rem;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }

  .glance th,
  .glance td {
    padding: var(--s-3) var(--s-4);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--c-line);
  }

  .glance thead th {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-ink-3);
    background: var(--c-sunken);
    white-space: nowrap;
  }

  .glance tbody tr:last-child > * {
    border-bottom: 0;
  }

  .glance tbody th {
    position: sticky;
    left: 0;
    background: var(--c-surface);
    font-weight: 620;
    min-width: 10rem;
  }

  .glance tbody th a {
    text-decoration: none;
  }

  .glance tbody th a:hover {
    color: var(--c-red-ink);
    text-decoration: underline;
  }

  .glance__company,
  .glance__sub {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--fs-xs);
    font-weight: 400;
    color: var(--c-ink-3);
  }

  .glance__fp {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    white-space: nowrap;
  }

  .glance__note {
    min-width: 16rem;
    color: var(--c-ink-2);
    line-height: 1.5;
  }

  .glance__cta {
    margin-top: var(--s-4);
  }

  .empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
</style>
