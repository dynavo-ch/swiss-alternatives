---
import CategoryCard from '~/components/CategoryCard.astro';
import Icon from '~/components/Icon.astro';
import PageHeader from '~/components/PageHeader.astro';
import { useTranslations } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getDirectory } from '~/lib/data';
import { paths } from '~/lib/paths';
import { breadcrumbLd } from '~/lib/seo';
import { localeStaticPaths } from '~/i18n/routing';

export const getStaticPaths = localeStaticPaths;

const t = useTranslations(Astro.currentLocale);
const { groups, stats } = await getDirectory(Astro.currentLocale);
const crumbs = [
  { label: t('nav.home'), href: paths.home() },
  { label: t('nav.categories'), href: paths.categories() },
];
---

<BaseLayout
  title={t('categories.title')}
  description={t('categories.description', { count: stats.categories })}
  jsonLd={breadcrumbLd(crumbs)}
>
  <PageHeader
    crumbs={crumbs}
    eyebrow={t('count.categories', { count: stats.categories })}
    title={t('categories.heading')}
    lead={t('categories.lead')}
  >
    <nav class="jump" aria-label={t('categories.jump')}>
      <ul role="list">
        {groups.map((g) => (
          <li>
            <a href={`#${g.id}`}>{g.data.name}</a>
          </li>
        ))}
      </ul>
    </nav>
  </PageHeader>

  {groups.map((group, i) => (
    <section class="section container group" id={group.id} aria-labelledby={`${group.id}-h`}>
      <header class="group__head">
        <p class="label group__num">{String(i + 1).padStart(2, '0')}</p>
        <div>
          <h2 class="h2" id={`${group.id}-h`}>
            <Icon name={group.data.icon} />
            {group.data.name}
          </h2>
          <p class="group__summary">{group.data.summary}</p>
        </div>
        <p class="group__count mono">{t('count.products', { count: group.productCount })}</p>
      </header>
      <ul class="grid-cards grid-cards--sm" role="list">
        {group.categories.map((category) => (
          <li>
            <CategoryCard category={category} />
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-8);
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0 var(--s-3);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-2);
    background: var(--c-surface);
    font-size: var(--fs-sm);
    font-weight: 540;
    text-decoration: none;
  }

  .jump a:hover {
    border-color: var(--c-ink);
  }

  .group {
    scroll-margin-top: var(--header-h);
  }

  .group + .group {
    padding-top: 0;
  }

  .group__head {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    gap: var(--s-4);
    align-items: start;
    margin-bottom: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--c-ink);
  }

  .group__num {
    color: var(--c-red-ink);
    padding-top: 0.6rem;
  }

  .group__head h2 {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .group__head h2 :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
    flex: none;
  }

  .group__summary {
    margin-top: var(--s-2);
    color: var(--c-ink-3);
  }

  .group__count {
    padding-top: 0.6rem;
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .group__head {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }
    .group__num,
    .group__count {
      padding-top: 0;
    }
  }
</style>
