---
import FilterableList from '~/components/FilterableList.astro';
import PageHeader from '~/components/PageHeader.astro';
import { useTranslations } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getDirectory } from '~/lib/data';
import { paths } from '~/lib/paths';
import { breadcrumbLd, itemListLd } from '~/lib/seo';

const t = useTranslations(Astro.currentLocale);
const { products, stats } = await getDirectory();
const crumbs = [
  { label: t('nav.home'), href: paths.home() },
  { label: t('nav.products'), href: paths.products() },
];
---

<BaseLayout
  title={t('products.title')}
  description={t('products.description', { count: stats.products, hosted: stats.swissHosted })}
  jsonLd={[itemListLd(t('products.title'), paths.products(), products), breadcrumbLd(crumbs)]}
>
  <PageHeader
    crumbs={crumbs}
    eyebrow={t('count.products', { count: stats.products })}
    title={t('products.heading')}
    lead={t('products.lead')}
  />
  <section class="section container" aria-label={t('nav.products')}>
    <FilterableList products={products} id="all-products" categoryFacet nameFilter />
  </section>
</BaseLayout>
