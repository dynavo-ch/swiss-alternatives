---
/**
 * Suggest a product — no backend. The helper form composes a GitHub issue,
 * an email or a ready-to-commit YAML snippet entirely in the browser;
 * nothing is sent until the visitor submits it on GitHub or in their mail app.
 */
import Icon from '~/components/Icon.astro';
import PageHeader from '~/components/PageHeader.astro';
import { site } from '~/config/site';
import { useTranslations } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { CANTONS } from '~/lib/constants';
import { getDirectory } from '~/lib/data';
import { cantonName } from '~/lib/format';
import { paths } from '~/lib/paths';
import { breadcrumbLd } from '~/lib/seo';

const t = useTranslations(Astro.currentLocale);
const { categories } = await getDirectory();
const crumbs = [
  { label: t('nav.home'), href: paths.home() },
  { label: t('nav.suggest'), href: paths.suggest() },
];
const issueUrl = `${site.repository}/issues/new?template=suggest-product.yml`;
const mailBody = `Product name:\nWebsite:\nCompany (legal name):\nHeadquarters (city, canton):\nCategory:\nWhy it qualifies:\nWhere is customer data hosted?\nSources (URLs):\n`;
const mailUrl = `mailto:${site.contactEmail}?subject=${encodeURIComponent('Product suggestion')}&body=${encodeURIComponent(mailBody)}`;
---

<BaseLayout
  title={t('suggest.title')}
  description={t('suggest.description')}
  jsonLd={breadcrumbLd(crumbs)}
>
  <PageHeader
    crumbs={crumbs}
    eyebrow={t('nav.suggest')}
    title={t('suggest.heading')}
    lead={t('suggest.description')}
  />

  <div class="container section suggest">
    <section class="suggest__ways" aria-labelledby="ways-h">
      <h2 class="label" id="ways-h">
        {t('suggest.ways')}
      </h2>
      <ol role="list" class="ways">
        <li class="way">
          <span class="way__num mono">01</span>
          <h3>{t('suggest.github')}</h3>
          <p>{t('suggest.githubText')}</p>
          <a href={issueUrl} class="btn" rel="noopener">
            <Icon name="github" />
            {t('suggest.githubCta')}
          </a>
        </li>
        <li class="way">
          <span class="way__num mono">02</span>
          <h3>{t('suggest.email')}</h3>
          <p>{t('suggest.emailText')}</p>
          <a href={mailUrl} class="btn">
            <Icon name="mail" />
            {site.contactEmail}
          </a>
        </li>
        <li class="way">
          <span class="way__num mono">03</span>
          <h3>{t('suggest.pr')}</h3>
          <p>{t('suggest.prText')}</p>
          <a
            href={`${site.repository}/blob/${site.repositoryBranch}/docs/CONTENT.md`}
            class="btn"
            rel="noopener"
          >
            <Icon name="file-text" />
            {t('suggest.prCta')}
          </a>
        </li>
      </ol>
    </section>

    <section class="helper" aria-labelledby="helper-h">
      <div class="helper__intro">
        <h2 class="h2" id="helper-h">
          {t('suggest.helper')}
        </h2>
        <p class="lead">{t('suggest.helperText')}</p>
        <ul class="checklist">
          <li>{t('suggest.check1')}</li>
          <li>{t('suggest.check2')}</li>
          <li>{t('suggest.check3')}</li>
        </ul>
        <p class="muted">
          <a href={paths.methodology()}>{t('nav.methodology')}</a>
        </p>
      </div>

      <form
        class="helper__form"
        data-suggest
        data-repo={site.repository}
        data-email={site.contactEmail}
      >
        <div class="field">
          <label class="field__label" for="s-name">
            {t('suggest.f.name')} *
          </label>
          <input class="input" id="s-name" name="name" required autocomplete="off" />
        </div>
        <div class="field">
          <label class="field__label" for="s-url">
            {t('suggest.f.url')} *
          </label>
          <input class="input" id="s-url" name="url" type="url" required placeholder="https://" />
        </div>
        <div class="field">
          <label class="field__label" for="s-company">
            {t('suggest.f.company')} *
          </label>
          <input class="input" id="s-company" name="company" required />
          <span class="field__hint">{t('suggest.f.companyHint')}</span>
        </div>
        <div class="field-row">
          <div class="field">
            <label class="field__label" for="s-city">
              {t('suggest.f.city')}
            </label>
            <input class="input" id="s-city" name="city" />
          </div>
          <div class="field">
            <label class="field__label" for="s-canton">
              {t('company.canton')}
            </label>
            <select class="select" id="s-canton" name="canton">
              <option value="">—</option>
              {CANTONS.map((c) => (
                <option value={c}>
                  {cantonName(c)} ({c})
                </option>
              ))}
            </select>
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="s-category">
            {t('suggest.f.category')}
          </label>
          <select class="select" id="s-category" name="category">
            <option value="">—</option>
            {categories.map((c) => (
              <option value={c.id}>{c.name}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label class="field__label" for="s-why">
            {t('suggest.f.why')} *
          </label>
          <textarea class="input textarea" id="s-why" name="why" required></textarea>
        </div>
        <div class="field">
          <label class="field__label" for="s-hosting">
            {t('suggest.f.hosting')}
          </label>
          <textarea class="input textarea" id="s-hosting" name="hosting"></textarea>
        </div>
        <div class="field">
          <label class="field__label" for="s-sources">
            {t('suggest.f.sources')} *
          </label>
          <textarea
            class="input textarea"
            id="s-sources"
            name="sources"
            required
            placeholder="https://…"
          ></textarea>
          <span class="field__hint">{t('suggest.f.sourcesHint')}</span>
        </div>
        <div class="helper__actions js-only">
          <button type="submit" class="btn btn--primary" data-action="github">
            <Icon name="github" />
            {t('suggest.openIssue')}
          </button>
          <button type="button" class="btn" data-action="email">
            <Icon name="mail" />
            {t('suggest.sendEmail')}
          </button>
          <button type="button" class="btn btn--ghost" data-action="yaml">
            <Icon name="copy" />
            {t('suggest.copyYaml')}
          </button>
        </div>
        <p class="field__hint js-only">{t('suggest.privacy')}</p>
        <noscript>
          <p class="field__hint">{t('suggest.noJs')}</p>
        </noscript>
      </form>
    </section>
  </div>
</BaseLayout>

<script>
  import { copyText, t, toast } from '~/scripts/store';

  const form = document.querySelector<HTMLFormElement>('[data-suggest]');
  if (form) {
    const value = (name: string) =>
      (form.elements.namedItem(name) as HTMLInputElement | null)?.value.trim() ?? '';
    const body = () =>
      [
        `**Product:** ${value('name')}`,
        `**Website:** ${value('url')}`,
        `**Company:** ${value('company')}`,
        `**Headquarters:** ${[value('city'), value('canton')].filter(Boolean).join(', ') || '—'}`,
        `**Category:** ${value('category') || '—'}`,
        '',
        '**Why it qualifies**',
        value('why'),
        '',
        '**Hosting / data location**',
        value('hosting') || '—',
        '',
        '**Sources**',
        value('sources'),
      ].join('\n');

    const slug = () =>
      value('name')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');

    const yaml = () =>
      [
        '---',
        `name: ${value('name')}`,
        `company: ${slug()}  # company slug — create src/content/companies/<slug>.yaml`,
        'tagline: ',
        'description: >-',
        '  ',
        `website: ${value('url')}`,
        `categories: [${value('category')}]`,
        'alternativesTo: []',
        'swiss:',
        '  developed: { value: unknown }',
        '  hosted: { value: unknown }',
        `added: ${new Date().toISOString().slice(0, 10)}`,
        'sources:',
        ...value('sources')
          .split(/\s+/)
          .filter((u) => u.startsWith('http'))
          .map((url, i) => `  - { id: s${i + 1}, title: "", url: ${url}, kind: vendor }`),
        '---',
        '',
        value('why'),
        '',
      ].join('\n');

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const url = new URL(`${form.dataset.repo}/issues/new`);
      url.searchParams.set('title', `Suggestion: ${value('name')}`);
      url.searchParams.set('labels', 'suggestion');
      url.searchParams.set('body', body());
      window.open(url.href, '_blank', 'noopener');
    });

    form.addEventListener('click', (event) => {
      const action = (event.target as Element).closest<HTMLElement>('[data-action]')?.dataset
        .action;
      if (action === 'email') {
        if (!form.reportValidity()) return;
        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Product suggestion: ${value('name')}`)}&body=${encodeURIComponent(body())}`;
      } else if (action === 'yaml') {
        if (!form.reportValidity()) return;
        void copyText(yaml()).then((ok) => ok && toast(t('common.copied')));
      }
    });
  }
</script>

<style>
  .ways {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin-top: var(--s-4);
  }

  .way {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--s-3);
    padding: var(--s-6);
    border: 1px solid var(--c-line);
    border-top: 2px solid var(--c-ink);
    background: var(--c-surface);
  }

  .way__num {
    color: var(--c-red-ink);
    font-size: var(--fs-xs);
  }

  .way h3 {
    font-size: var(--fs-md);
  }

  .way p {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
  }

  .way .btn {
    margin-top: var(--s-2);
  }

  @media (max-width: 56rem) {
    .ways {
      grid-template-columns: 1fr;
    }
  }

  .helper {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: var(--s-12);
    margin-top: var(--section);
    padding-top: var(--s-8);
    border-top: 1px solid var(--c-ink);
  }

  .helper__intro .lead {
    margin-top: var(--s-4);
  }

  .checklist {
    margin: var(--s-6) 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--s-2);
  }

  .checklist li {
    display: flex;
    gap: var(--s-3);
    font-size: var(--fs-sm);
  }

  .checklist li::before {
    content: '';
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    margin-top: 0.45rem;
    background: var(--c-red);
  }

  .helper__form {
    display: grid;
    gap: var(--s-5);
    padding: var(--s-6);
    border: 1px solid var(--c-line);
    border-radius: var(--r-2);
    background: var(--c-surface);
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4);
  }

  .helper__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  @media (max-width: 56rem) {
    .helper {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }
  }

  @media (max-width: 30rem) {
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
