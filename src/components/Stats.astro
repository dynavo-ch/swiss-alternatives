---
/** Build-time statistics strip. Every number is computed from content. */
import { useTranslations } from '~/i18n';
import { getDirectory } from '~/lib/data';
import { formatNumber } from '~/lib/format';
import { paths } from '~/lib/paths';

const t = useTranslations(Astro.currentLocale);
const { stats } = await getDirectory();
const items = [
  { value: stats.products, label: t('stats.products'), href: paths.products() },
  { value: stats.companies, label: t('stats.companies'), href: paths.companies() },
  { value: stats.categories, label: t('stats.categories'), href: paths.categories() },
  {
    value: stats.swissHosted,
    label: t('stats.swissHosted'),
    href: `${paths.products()}?f=swiss-hosted`,
  },
  {
    value: stats.openSource,
    label: t('stats.openSource'),
    href: `${paths.products()}?f=open-source`,
  },
  { value: stats.cantons, label: t('stats.cantons'), href: paths.companies() },
];
---

<dl class="stats">
  {items.map((item) => (
    <div class="stats__item">
      <dt class="label">{item.label}</dt>
      <dd>
        <a href={item.href} class="stats__value tnum">
          {formatNumber(item.value)}
        </a>
      </dd>
    </div>
  ))}
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-top: 1px solid var(--c-ink);
    border-bottom: 1px solid var(--c-line);
  }

  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--s-2);
    padding: var(--s-5) var(--s-4) var(--s-5) 0;
  }

  .stats__item + .stats__item {
    padding-left: var(--s-4);
    border-left: 1px solid var(--c-line);
  }

  .stats__value {
    display: block;
    font-size: var(--fs-3xl);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 1;
    text-decoration: none;
    color: var(--c-ink);
    transition: color var(--t-fast) var(--ease);
  }

  .stats__value:hover {
    color: var(--c-red-ink);
  }

  @media (max-width: 60rem) {
    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .stats__item:nth-child(4) {
      padding-left: 0;
      border-left: 0;
    }
    .stats__item:nth-child(n + 4) {
      border-top: 1px solid var(--c-line);
    }
  }

  @media (max-width: 30rem) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stats__item:nth-child(n) {
      padding-left: var(--s-4);
      border-left: 1px solid var(--c-line);
    }
    .stats__item:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .stats__item:nth-child(n + 3) {
      border-top: 1px solid var(--c-line);
    }
  }
</style>
