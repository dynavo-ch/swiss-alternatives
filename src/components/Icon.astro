---
/**
 * Inline SVG icon. Decorative by default; pass `label` for a standalone
 * meaningful icon.
 */
import type { HTMLAttributes } from 'astro/types';
import { iconBody } from '~/lib/icons';

interface Props extends HTMLAttributes<'svg'> {
  name: string;
  size?: number | string;
  strokeWidth?: number;
  label?: string;
}

const { name, size, strokeWidth = 1.75, label, ...rest } = Astro.props;
const body = iconBody(name);
const dimension = typeof size === 'number' ? `${size}px` : size;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  width={dimension}
  height={dimension}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  {...rest}
  set:html={body}
/>
