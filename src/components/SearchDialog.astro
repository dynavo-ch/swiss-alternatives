---
import SearchBox from './SearchBox.astro';
import { useTranslations } from '~/i18n';

const t = useTranslations(Astro.currentLocale);
---

<dialog id="search-dialog" class="search-dialog" aria-label={t('search.label')}>
  <SearchBox variant="dialog" id="search-dialog-input" />
</dialog>

<style is:global>
  .search-dialog {
    width: min(42rem, calc(100vw - 2rem));
    max-height: min(36rem, calc(100dvh - 4rem));
    margin: clamp(1rem, 10vh, 6rem) auto auto;
    padding: 0;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-3);
    background: var(--c-raised);
    color: var(--c-ink);
    box-shadow: var(--shadow-pop);
    overflow: hidden;
  }

  .search-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .search-dialog::backdrop {
    background: var(--c-overlay);
  }

  .search-dialog .search {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1;
  }

  .search-dialog .search__form {
    border: 0;
    border-bottom: 1px solid var(--c-line);
    border-radius: 0;
    box-shadow: none;
    padding-right: var(--s-4);
  }

  .search-dialog .search__input {
    height: 3.5rem;
  }

  .search-dialog .search__panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1;
  }

  .search-dialog .search__list {
    overflow-y: auto;
    padding: var(--s-2);
    flex: 1;
  }

  .search__esc {
    cursor: pointer;
  }

  @media (prefers-reduced-motion: no-preference) {
    .search-dialog[open] {
      animation: dialog-in var(--t-med) var(--ease);
    }

    @keyframes dialog-in {
      from {
        opacity: 0;
        translate: 0 -6px;
      }
    }
  }

  @media (max-width: 40rem) {
    .search-dialog {
      width: 100vw;
      max-width: 100vw;
      height: 100dvh;
      max-height: 100dvh;
      margin: 0;
      border: 0;
      border-radius: 0;
    }
  }
</style>
