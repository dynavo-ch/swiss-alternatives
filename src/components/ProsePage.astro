---
/** Renders an entry from the `pages` collection for the current locale. */
import { getEntry, render } from 'astro:content';
import PageHeader from './PageHeader.astro';
import { resolveLocale, useTranslations } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { formatDate, isoDate } from '~/lib/format';
import { paths } from '~/lib/paths';
import { breadcrumbLd } from '~/lib/seo';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const entry =
  (await getEntry('pages', `${locale}/${slug}`)) ?? (await getEntry('pages', `en/${slug}`));
if (!entry) throw new Error(`Missing page content: src/content/pages/en/${slug}.md`);
const { Content } = await render(entry);
const crumbs = [
  { label: t('nav.home'), href: paths.home() },
  { label: entry.data.title, href: Astro.url.pathname },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  jsonLd={breadcrumbLd(crumbs)}
>
  <PageHeader
    crumbs={crumbs}
    eyebrow={entry.data.eyebrow}
    title={entry.data.title}
    lead={entry.data.description}
    size="md"
  />
  <div class="container section">
    <div class="prose-page">
      <div class="prose">
        <slot name="before" />
        <Content />
        <slot />
      </div>
      {entry.data.updated && (
        <p class="prose-page__updated label">
          {t('common.updated')}{' '}
          <time datetime={isoDate(entry.data.updated)}>
            {formatDate(entry.data.updated, locale)}
          </time>
        </p>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .prose-page {
    max-width: 46rem;
  }

  .prose-page__updated {
    margin-top: var(--s-12);
    padding-top: var(--s-4);
    border-top: 1px solid var(--c-line);
  }
</style>
