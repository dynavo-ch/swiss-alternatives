---
import Icon from './Icon.astro';
import InlineScript from './InlineScript.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { useTranslations } from '~/i18n';
import { shortcutLabel } from '~/lib/inline-scripts';
import { paths } from '~/lib/paths';

const t = useTranslations(Astro.currentLocale);
const current = Astro.url.pathname;

const nav = [
  { href: paths.products(), label: t('nav.explore'), match: ['/products/', '/product/'] },
  { href: paths.categories(), label: t('nav.categories'), match: ['/categories/', '/category/'] },
  { href: paths.alternatives(), label: t('nav.alternatives'), match: ['/alternatives/'] },
  { href: paths.latest(), label: t('nav.latest'), match: ['/latest/'] },
  { href: paths.about(), label: t('nav.about'), match: ['/about/', '/methodology/'] },
  {
    href: paths.contribute(),
    label: t('nav.contribute'),
    match: ['/contribute/', '/suggest/', '/contact/', '/sponsors/'],
  },
];
const isCurrent = (match: string[]) => match.some((m) => current.startsWith(m));
---

<header class="header">
  <div class="header__inner container">
    <a
      href={paths.home()}
      class="header__brand"
      aria-label={`${t('nav.home')} — Swiss Alternatives`}
    >
      <Logo />
    </a>

    <nav class="header__nav" aria-label={t('nav.main')}>
      <ul role="list">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="header__link"
              aria-current={
                current === item.href ? 'page' : isCurrent(item.match) ? 'true' : undefined
              }
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__tools">
      <a href={paths.search()} class="header__search" data-search-open>
        <Icon name="search" />
        <span class="header__search-text">{t('search.placeholderShort')}</span>
        <span class="kbd js-only" data-shortcut aria-hidden="true">
          ⌘K
        </span>
      </a>
      <a
        href={paths.search()}
        class="icon-btn header__search-icon"
        data-search-open
        aria-label={t('search.open')}
      >
        <Icon name="search" />
      </a>
      <a
        href={paths.favourites()}
        class="icon-btn header__fav"
        aria-label={t('nav.favourites')}
        title={t('nav.favourites')}
      >
        <Icon name="heart" />
        <span class="header__fav-count" data-fav-count hidden></span>
      </a>
      <ThemeToggle />
      <button
        type="button"
        class="icon-btn header__menu js-only"
        data-menu-open
        aria-haspopup="dialog"
        aria-controls="site-menu"
        aria-label={t('nav.menu')}
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <dialog id="site-menu" class="menu" aria-label={t('nav.menu')}>
    <div class="menu__head">
      <Logo />
      <button type="button" class="icon-btn" data-menu-close aria-label={t('nav.closeMenu')}>
        <Icon name="x" />
      </button>
    </div>
    <nav aria-label={t('nav.main')}>
      <ul role="list" class="menu__list">
        {nav.map((item, i) => (
          <li>
            <a
              href={item.href}
              class="menu__link"
              aria-current={isCurrent(item.match) ? 'page' : undefined}
            >
              <span class="label">{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a href={paths.companies()} class="menu__link">
            <span class="label">07</span>
            {t('nav.companies')}
          </a>
        </li>
      </ul>
    </nav>
    <div class="menu__secondary">
      <a href={paths.favourites()} class="btn">
        <Icon name="heart" />
        {t('nav.favourites')}
      </a>
      <a href={paths.suggest()} class="btn">
        <Icon name="plus" />
        {t('nav.suggest')}
      </a>
      <ThemeToggle withLabel />
    </div>
  </dialog>
</header>

<InlineScript code={shortcutLabel} />

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    height: var(--header-h);
  }

  .header__brand {
    text-decoration: none;
    flex: none;
  }

  .header__nav ul {
    display: flex;
    gap: var(--s-1);
  }

  .header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: var(--header-h);
    padding: 0 var(--s-3);
    font-size: var(--fs-base);
    font-weight: 520;
    color: var(--c-ink-2);
    text-decoration: none;
    transition: color var(--t-fast) var(--ease);
  }

  .header__link:hover {
    color: var(--c-ink);
  }

  .header__link[aria-current] {
    color: var(--c-ink);
  }

  .header__link[aria-current]::after {
    content: '';
    position: absolute;
    left: var(--s-3);
    right: var(--s-3);
    bottom: -1px;
    height: 2px;
    background: var(--c-red);
  }

  .header__tools {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    margin-left: auto;
  }

  .header__search {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    width: 15rem;
    height: 2.25rem;
    margin-right: var(--s-2);
    padding: 0 var(--s-2) 0 var(--s-3);
    border: 1px solid var(--c-control);
    border-radius: var(--r-2);
    background: var(--c-surface);
    color: var(--c-ink-3);
    font-size: var(--fs-sm);
    text-decoration: none;
    transition: border-color var(--t-fast) var(--ease);
  }

  .header__search:hover {
    border-color: var(--c-ink);
    color: var(--c-ink-2);
  }

  .header__search svg {
    width: 1rem;
    height: 1rem;
  }

  .header__search-text {
    flex: 1;
  }

  .header__fav {
    position: relative;
  }

  .header__fav-count {
    position: absolute;
    top: 2px;
    right: 1px;
    min-width: 1rem;
    height: 1rem;
    padding: 0 0.2rem;
    border-radius: var(--r-1);
    background: var(--c-red-fill);
    color: var(--c-on-red);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1rem;
    text-align: center;
  }

  .header__search-icon,
  .header__menu {
    display: none;
  }

  @media (max-width: 78rem) {
    .header__search {
      width: auto;
    }
    .header__search .kbd {
      display: none;
    }
    /* Keep the text for assistive technology; hide it visually. */
    .header__search-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .header__search {
      border: 0;
      background: none;
      width: 2.25rem;
      padding: 0;
      margin: 0;
      justify-content: center;
      color: var(--c-ink-2);
    }
    .header__search svg {
      width: 1.15rem;
      height: 1.15rem;
    }
  }

  @media (max-width: 58rem) {
    .header__nav {
      display: none;
    }
    :global(.js) .header__menu {
      display: inline-grid;
    }
    .header__tools :global(.theme-toggle) {
      display: none;
    }
  }

  /* No JS: keep the nav reachable by letting it scroll horizontally. */
  @media (max-width: 58rem) {
    :global(.no-js) .header__nav {
      display: block;
      overflow-x: auto;
    }
    :global(.no-js) .header__brand :global(.logo__word) {
      display: none;
    }
  }

  /* Mobile menu ----------------------------------------------------- */
  .menu {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0 var(--gutter) var(--s-8);
    border: 0;
    background: var(--c-bg);
    color: var(--c-ink);
  }

  .menu[open] {
    display: flex;
    flex-direction: column;
  }

  .menu::backdrop {
    background: var(--c-overlay);
  }

  .menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    border-bottom: 1px solid var(--c-line);
  }

  .menu__list {
    margin-top: var(--s-4);
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--c-line);
    font-size: var(--fs-2xl);
    font-weight: 620;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .menu__link[aria-current] {
    color: var(--c-red-ink);
  }

  .menu__secondary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: auto;
    padding-top: var(--s-8);
  }
</style>
