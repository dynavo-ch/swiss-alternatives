---
/**
 * Logo tile. Normalised logos (src/assets/logos/) are shown edge to edge;
 * other images are inset; without a logo a typographic monogram is shown.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { monogram } from '~/lib/format';

interface Props {
  name: string;
  logo?: ImageMetadata | undefined;
  normalized?: boolean;
  size?: 'sm' | 'md' | 'lg';
}

const { name, logo, normalized = true, size = 'md' } = Astro.props;
const px = size === 'sm' ? 32 : size === 'lg' ? 72 : 44;
---

{logo ? (
  <span
    class:list={[
      'logo-tile',
      size !== 'md' && `logo-tile--${size}`,
      normalized && 'logo-tile--img',
    ]}
  >
    <Image src={logo} alt="" width={px * 2} height={px * 2} loading="lazy" decoding="async" />
  </span>
) : (
  <span
    class:list={['logo-tile', 'logo-tile--mono', size !== 'md' && `logo-tile--${size}`]}
    aria-hidden="true"
  >
    {monogram(name)}
  </span>
)}
