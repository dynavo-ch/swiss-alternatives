# Security headers for Netlify and Cloudflare Pages.
# The Content-Security-Policy itself is emitted per page as a <meta> tag by Astro
# (with hashes for every inline script); these headers complement it.
# frame-ancestors is ignored in <meta> policies, so it is sent as a header. Browsers
# enforce both policies; X-Frame-Options stays for older browsers.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/search-index.json
  Cache-Control: public, max-age=3600

/data/products.json
  Cache-Control: public, max-age=3600
